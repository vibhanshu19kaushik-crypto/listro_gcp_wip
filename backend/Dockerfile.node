FROM node:20-bullseye-slim


# Working directory for the node backend
WORKDIR /app/backend


# Install Python + pip for scraper scripts
RUN apt-get update && apt-get install -y --no-install-recommends \
   python3 \
   python3-pip \
   && rm -rf /var/lib/apt/lists/*


# Install Python deps needed by scraper.py & amz_scraper.py
RUN pip3 install --no-cache-dir requests beautifulsoup4 google-cloud-storage


# Install Node deps - copy from backend folder
COPY backend/package*.json ./
RUN npm ci --omit=dev


# Copy all backend source files
COPY backend/ .


# Create necessary directories
RUN mkdir -p generated_images downloaded_images


# Cloud Run will inject PORT; default to 8080
ENV PORT=8080
ENV NODE_ENV=production


EXPOSE 8080


CMD ["node", "server.js"]

