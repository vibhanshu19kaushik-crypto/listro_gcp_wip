FROM python:3.12-slim


WORKDIR /app


# System deps for Pillow, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
   build-essential \
   libjpeg-dev \
   zlib1g-dev \
   && rm -rf /var/lib/apt/lists/*


# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt


# Copy the Python server code (using standard python-server.py)
COPY python-server.py ./python-server.py
COPY scraper.py .
COPY amz_scraper.py .
COPY amz_metadata_scraper.py .
COPY pnd.py .


# Create necessary directories
RUN mkdir -p generated_images downloaded_images


# Cloud Run will set PORT to 8080
ENV PORT=8080
ENV FLASK_ENV=production
ENV ENV=production


EXPOSE 8080


# Start Flask app
CMD ["python", "python-server.py"]

